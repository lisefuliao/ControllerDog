<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="StatusPillBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
        <Setter Property="Background" Value="{DynamicResource ChipBackgroundBrush}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="MappingRowBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ChipBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,0,0,7" />
    </Style>

    <Style x:Key="CompactMappingRowBorderStyle" TargetType="Border" BasedOn="{StaticResource MappingRowBorderStyle}">
        <Setter Property="Padding" Value="9,7" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>
</ResourceDictionary>
