<Window x:Class="DouDouDeDou.Controls.InputCaptureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑映射目标"
        Width="860"
        Height="620"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI"
        Background="Transparent"
        AllowsTransparency="True"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewMouseDown="OnPreviewMouseDown">
    <Window.Resources>
        <Style x:Key="KeyButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="WideKeyButtonStyle" TargetType="Button" BasedOn="{StaticResource KeyButtonStyle}">
            <Setter Property="MinWidth" Value="88" />
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="1"
            CornerRadius="24"
            Padding="24"
            Effect="{StaticResource SoftShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="选择映射目标"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock x:Name="CurrentTargetText"
                               Text="当前：未选择"
                               Margin="0,6,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="开始捕获"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="112"
                        Click="OnStartCaptureClick" />
            </Grid>

            <Border Grid.Row="1"
                    x:Name="CaptureBanner"
                    Margin="0,18,0,18"
                    Background="{StaticResource SoftPinkBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14"
                    Opacity="0.0">
                <TextBlock Text="请按下你想映射的键盘键或鼠标按键"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" />
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.45*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Background="#FFFFFD"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="16">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="键盘布局"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,12" />
                        <StackPanel>
                            <WrapPanel>
                                <Button Content="Esc" Tag="Keyboard:Escape" Style="{StaticResource KeyButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="F1" Tag="Keyboard:F1" Style="{StaticResource KeyButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="F2" Tag="Keyboard:F2" Style="{StaticResource KeyButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="F3" Tag="Keyboard:F3" Style="{StaticResource KeyButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="F4" Tag="Keyboard:F4" Style="{StaticResource KeyButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="F5" Tag="Keyboard:F5" Style="{StaticResource KeyButtonStyle}" Click="OnTargetButtonClick" />
                            </WrapPanel>
                            <WrapPanel>
                                <Button Content="Q" Tag="Keyboard:Q" Style="{StaticResource KeyButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="W" Tag="Keyboard:W" Style="{StaticResource KeyButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="E" Tag="Keyboard:E" Style="{StaticResource KeyButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="R" Tag="Keyboard:R" Style="{StaticResource KeyButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="T" Tag="Keyboard:T" Style="{StaticResource KeyButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="Y" Tag="Keyboard:Y" Style="{StaticResource KeyButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="U" Tag="Keyboard:U" Style="{StaticResource KeyButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="I" Tag="Keyboard:I" Style="{StaticResource KeyButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="O" Tag="Keyboard:O" Style="{StaticResource KeyButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="P" Tag="Keyboard:P" Style="{StaticResource KeyButtonStyle}" Click="OnTargetButtonClick" />
                            </WrapPanel>
                            <WrapPanel>
                                <Button Content="A" Tag="Keyboard:A" Style="{StaticResource KeyButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="S" Tag="Keyboard:S" Style="{StaticResource KeyButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="D" Tag="Keyboard:D" Style="{StaticResource KeyButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="F" Tag="Keyboard:F" Style="{StaticResource KeyButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="G" Tag="Keyboard:G" Style="{StaticResource KeyButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="H" Tag="Keyboard:H" Style="{StaticResource KeyButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="J" Tag="Keyboard:J" Style="{StaticResource KeyButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="K" Tag="Keyboard:K" Style="{StaticResource KeyButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="L" Tag="Keyboard:L" Style="{StaticResource KeyButtonStyle}" Click="OnTargetButtonClick" />
                            </WrapPanel>
                            <WrapPanel>
                                <Button Content="Shift" Tag="Keyboard:LeftShift" Style="{StaticResource WideKeyButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="Z" Tag="Keyboard:Z" Style="{StaticResource KeyButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="X" Tag="Keyboard:X" Style="{StaticResource KeyButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="C" Tag="Keyboard:C" Style="{StaticResource KeyButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="V" Tag="Keyboard:V" Style="{StaticResource KeyButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="B" Tag="Keyboard:B" Style="{StaticResource KeyButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="N" Tag="Keyboard:N" Style="{StaticResource KeyButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="M" Tag="Keyboard:M" Style="{StaticResource KeyButtonStyle}" Click="OnTargetButtonClick" />
                            </WrapPanel>
                            <WrapPanel>
                                <Button Content="Ctrl" Tag="Keyboard:LeftCtrl" Style="{StaticResource WideKeyButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="Alt" Tag="Keyboard:LeftAlt" Style="{StaticResource WideKeyButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="Space" Tag="Keyboard:Space" Style="{StaticResource WideKeyButtonStyle}" MinWidth="184" Click="OnTargetButtonClick" />
                                <Button Content="Enter" Tag="Keyboard:Enter" Style="{StaticResource WideKeyButtonStyle}" Click="OnTargetButtonClick" />
                            </WrapPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="#FFFFFD"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="16">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="鼠标按钮"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,12" />
                        <StackPanel>
                            <Grid Height="210" Margin="0,0,0,14">
                                <Border Width="112" Height="190" CornerRadius="54"
                                        Background="#FFF7FA"
                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                <Button Content="左键" Tag="Mouse:LeftButton" Width="54" Height="76" Margin="0,16,54,0"
                                        VerticalAlignment="Top" HorizontalAlignment="Center"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="右键" Tag="Mouse:RightButton" Width="54" Height="76" Margin="54,16,0,0"
                                        VerticalAlignment="Top" HorizontalAlignment="Center"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="中键" Tag="Mouse:MiddleButton" Width="40" Height="48" Margin="0,24,0,0"
                                        VerticalAlignment="Top" HorizontalAlignment="Center"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="侧1" Tag="Mouse:XButton1" Width="56" Height="34" Margin="0,92,126,0"
                                        VerticalAlignment="Top" HorizontalAlignment="Center"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="侧2" Tag="Mouse:XButton2" Width="56" Height="34" Margin="0,132,126,0"
                                        VerticalAlignment="Top" HorizontalAlignment="Center"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="OnTargetButtonClick" />
                            </Grid>

                            <TextBlock Text="快速推荐"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,10" />
                            <WrapPanel>
                                <Button Content="鼠标左键" Tag="Mouse:LeftButton" Style="{StaticResource WideKeyButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="鼠标右键" Tag="Mouse:RightButton" Style="{StaticResource WideKeyButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="M" Tag="Keyboard:M" Style="{StaticResource KeyButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="Space" Tag="Keyboard:Space" Style="{StaticResource WideKeyButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="Shift" Tag="Keyboard:LeftShift" Style="{StaticResource WideKeyButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="Ctrl" Tag="Keyboard:LeftCtrl" Style="{StaticResource WideKeyButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="R" Tag="Keyboard:R" Style="{StaticResource KeyButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="E" Tag="Keyboard:E" Style="{StaticResource KeyButtonStyle}" Click="OnTargetButtonClick" />
                                <Button Content="F" Tag="Keyboard:F" Style="{StaticResource KeyButtonStyle}" Click="OnTargetButtonClick" />
                            </WrapPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="3" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="只绑定一个键盘键或一个鼠标键。不会生成宏、连发或固定输入序列。"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <Button Grid.Column="1" Content="取消" Style="{StaticResource SecondaryButtonStyle}" MinWidth="92" Click="OnCancelClick" />
                <Button Grid.Column="3" Content="确定" Style="{StaticResource PrimaryButtonStyle}" MinWidth="92" Click="OnOkClick" />
            </Grid>
        </Grid>
    </Border>
</Window>
