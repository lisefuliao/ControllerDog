<Window x:Class="DouDouDeDou.Controls.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="抖抖的抖 - 设置"
        Width="1120"
        Height="720"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Icon="Assets/Icons/app-icon.png"
        FontFamily="Microsoft YaHei UI"
        Background="{DynamicResource BackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,1,0" Padding="24">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,34">
                        <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource SoftPinkBrush}" ClipToBounds="True" Margin="0,0,12,0">
                            <Image Source="Assets/Icons/app-icon.png" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="抖抖的抖" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="v0.5 UI Preview" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Border CornerRadius="14" Background="{DynamicResource SoftPinkBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Padding="14,12" Margin="0,0,0,10">
                        <TextBlock Text="应用设置" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="映射设置" Foreground="{DynamicResource TextSecondaryBrush}" Margin="14,10" FontWeight="SemiBold" />
                    <TextBlock Text="设备设置" Foreground="{DynamicResource TextSecondaryBrush}" Margin="14,10" FontWeight="SemiBold" />
                    <TextBlock Text="关于我们" Foreground="{DynamicResource TextSecondaryBrush}" Margin="14,10" FontWeight="SemiBold" />
                </StackPanel>

                <Button DockPanel.Dock="Bottom" Content="恢复默认设置" Style="{StaticResource SecondaryButtonStyle}" />
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock Text="应用设置" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="自定义外观、行为和性能选项" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" />
                </StackPanel>
                <Button Content="保存设置" Command="{Binding SaveConfigCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" MinWidth="112" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,14">
                    <StackPanel>
                        <TextBlock Text="外观" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="主题模式" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,8,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <Button Content="☀  浅色" Command="{Binding ToggleThemeModeCommand}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="120" Margin="0,0,10,0" />
                            <Button Content="☾  深色" Command="{Binding ToggleThemeModeCommand}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="120" />
                        </StackPanel>

                        <TextBlock Text="主题色" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Themes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Width="30"
                                            Height="30"
                                            Padding="0"
                                            Margin="0,0,10,0"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            ToolTip="{Binding DisplayName}">
                                        <Grid>
                                            <Ellipse Fill="{Binding PreviewBrush}" />
                                            <Ellipse Stroke="{DynamicResource CardBrush}" StrokeThickness="3" Margin="3" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="12,0,0,14">
                    <StackPanel>
                        <TextBlock Text="预览" Style="{StaticResource SectionTitleStyle}" />
                        <Border CornerRadius="16" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" Background="{DynamicResource SoftPinkBrush}" Height="150" Margin="0,12,0,0">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ThemeModeIcon}" FontSize="36" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding ThemeModeText}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="性能" Style="{StaticResource SectionTitleStyle}" />
                        <Grid Grid.Row="1" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="默认轮询率" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="设置新配置和新设备的默认轮询率" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding PollingRates}" SelectedItem="{Binding SelectedPollingRate, Mode=TwoWay}" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="12,0,0,14">
                    <StackPanel>
                        <TextBlock Text="控制器显示" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="当前保留 DS4、XInput 和 DualSense 的简约交互预览。后续可接入真实拆分素材，让按键本体直接高亮。" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="22" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}" Margin="0,0,0,0">
                    <TextBlock Text="提示：这页设置会逐步扩展。当前已经可以调整主题、强调色和轮询率；不改变映射、检测和发布配置。"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                </Border>
            </Grid>

            <TextBlock Grid.Row="2" Text="作者：马德锦大神    |    感谢使用抖抖的抖"
                       HorizontalAlignment="Right"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="12"
                       Margin="0,18,0,0" />
        </Grid>
    </Grid>
</Window>
