<Window x:Class="DouDouDeDou.Controls.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DouDouDeDou.Controls"
        Title="抖抖的抖 - 设置"
        Width="1040"
        Height="700"
        MinWidth="920"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/Branding/AppIcon.png"
        FontFamily="Microsoft YaHei UI"
        Background="{DynamicResource BackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal">
                <Border Width="46" Height="46" CornerRadius="15" Background="{DynamicResource AccentSoftBrush}" ClipToBounds="True" Margin="0,0,12,0">
                    <Image Source="/Assets/Branding/AppIcon.png" Stretch="UniformToFill" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="设置中心" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="只保留高频可用设置，低频操作收进分组。" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
            <Button Content="保存设置" Command="{Binding SaveConfigCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <TabControl Grid.Row="1" TabStripPlacement="Left">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource IconBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="外观" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,0,0,0">
                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel>
                                <TextBlock Text="外观" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="显示模式" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Button Content="{Binding ThemeModeText}" Command="{Binding ToggleThemeModeCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" />
                                    <Button Content="跟随系统" IsEnabled="False" Style="{StaticResource OutlineButtonStyle}" />
                                </StackPanel>

                                <TextBlock Text="主题色预设" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding Themes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SelectThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Padding="9,6"
                                                    MinWidth="92"
                                                    Margin="0,0,8,8"
                                                    ToolTip="{Binding DisplayName}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="14" Height="14" Fill="{Binding PreviewBrush}" Margin="0,0,7,0" />
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="恢复默认粉色" Command="{Binding ResetThemeCommand}" Style="{StaticResource OutlineButtonStyle}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7FC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource IconBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="控制器" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,0,0,0">
                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel>
                                <TextBlock Text="控制器" Style="{StaticResource SectionTitleStyle}" />
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="190" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="目标轮询率" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="主界面保持短标签，完整说明放在下拉列表。" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding PollingRates}" SelectedItem="{Binding SelectedPollingRate, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ListDisplayName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                <controls:StatusBadge Label="当前类型" Value="{Binding ControllerTypeText}" />
                                <controls:StatusBadge Label="协议" Value="{Binding ControllerProtocolText}" />
                                <controls:StatusBadge Label="显示策略" Value="按控制器类型自动切换底图和高亮" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource IconBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="配置" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,0,0,0">
                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel>
                                <TextBlock Text="配置" Style="{StaticResource SectionTitleStyle}" />
                                <Border Style="{StaticResource ProfileCardStyle}" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding CurrentProfileName}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding MappingProgressText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Width="190" SelectedIndex="0">
                                            <ComboBoxItem Content="默认配置" />
                                        </ComboBox>
                                    </Grid>
                                </Border>
                                <controls:StatusBadge Label="映射进度" Value="{Binding MappingProgressText}" />
                                <controls:StatusBadge Label="未映射键" Value="{Binding UnmappedKeyText}" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="新建" Command="{Binding NewConfigCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" />
                                    <Button Content="保存" Command="{Binding SaveConfigCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0" />
                                    <Button Content="导入" Command="{Binding LoadConfigCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" />
                                    <Button Content="导出" Command="{Binding SaveAsConfigCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource IconBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="日志与诊断" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,0,0,0">
                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel>
                                <TextBlock Text="日志与诊断" Style="{StaticResource SectionTitleStyle}" />
                                <controls:StatusBadge Label="日志目录" Value="{Binding LogsDirectoryText}" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="查看日志" Command="{Binding OpenLogsCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" />
                                    <Button Content="导出日志" Command="{Binding ExportLogsCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" />
                                    <Button Content="清空日志" Command="{Binding ClearLogsCommand}" Style="{StaticResource DangerOutlineButtonStyle}" Margin="0,0,10,0" />
                                    <Button Content="打开目录" Command="{Binding OpenLogsDirectoryCommand}" Style="{StaticResource OutlineButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource IconBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="存储与清理" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,0,0,0">
                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel>
                                <TextBlock Text="配置文件" Style="{StaticResource SectionTitleStyle}" />
                                <controls:StatusBadge Label="保存位置" Value="{Binding ConfigDirectoryText}" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="打开配置目录" Command="{Binding OpenConfigDirectoryCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" />
                                    <Button Content="修改保存位置" Command="{Binding ChangeConfigDirectoryCommand}" Style="{StaticResource OutlineButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel>
                                <TextBlock Text="缓存" Style="{StaticResource SectionTitleStyle}" />
                                <controls:StatusBadge Label="缓存目录" Value="{Binding CacheDirectoryText}" />
                                <controls:StatusBadge Label="当前占用" Value="{Binding CacheSizeText}" />
                                <Button Content="清理缓存" Command="{Binding ClearCacheCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource IconBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="关于" />
                    </StackPanel>
                </TabItem.Header>
                <StackPanel Margin="22,0,0,0">
                    <Border Style="{StaticResource SettingsSectionStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="62" Height="62" CornerRadius="18" Background="{DynamicResource AccentSoftBrush}" ClipToBounds="True">
                                <Image Source="/Assets/Branding/AppIcon.png" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="抖抖的抖" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="v0.5 UI Preview  |  作者：马德锦大神" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                <TextBlock Text="轻量手柄到键盘/鼠标映射工具。" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="检查更新" IsEnabled="False" Style="{StaticResource OutlineButtonStyle}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
