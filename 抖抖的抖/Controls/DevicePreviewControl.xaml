<UserControl x:Class="DouDouDeDou.Controls.DevicePreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="260">
    <Grid>
        <Viewbox Stretch="Uniform">
            <Canvas Width="520" Height="310">
                <Path x:Name="ControllerShell"
                      Data="M102,88 C68,92 42,126 33,174 C23,229 45,266 84,260 C111,256 126,225 146,211 C177,190 205,203 260,203 C315,203 343,190 374,211 C394,225 409,256 436,260 C475,266 497,229 487,174 C478,126 452,92 418,88 C383,76 349,83 316,104 C300,114 283,119 260,119 C237,119 220,114 204,104 C171,83 137,76 102,88 Z"
                      Fill="#FFFFFD"
                      Stroke="{StaticResource BorderBrushSoft}"
                      StrokeThickness="4"
                      StrokeLineJoin="Round" />

                <Path x:Name="ControllerInnerLine"
                      Data="M144,108 C173,126 202,135 260,135 C318,135 347,126 376,108"
                      Stroke="#F2D5DD"
                      StrokeThickness="2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Fill="Transparent" />

                <Border x:Name="ButtonLT" Canvas.Left="94" Canvas.Top="45" Width="116" Height="34" CornerRadius="13"
                        Background="#FFF1F5" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1.5">
                    <TextBlock x:Name="LabelLT" Text="LT" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                </Border>
                <Border x:Name="ButtonRT" Canvas.Left="310" Canvas.Top="45" Width="116" Height="34" CornerRadius="13"
                        Background="#FFF1F5" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1.5">
                    <TextBlock x:Name="LabelRT" Text="RT" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                </Border>
                <Border x:Name="ButtonLB" Canvas.Left="105" Canvas.Top="82" Width="100" Height="30" CornerRadius="12"
                        Background="#FFF8FA" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1.5">
                    <TextBlock x:Name="LabelLB" Text="LB" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                </Border>
                <Border x:Name="ButtonRB" Canvas.Left="315" Canvas.Top="82" Width="100" Height="30" CornerRadius="12"
                        Background="#FFF8FA" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1.5">
                    <TextBlock x:Name="LabelRB" Text="RB" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                </Border>

                <Grid Canvas.Left="96" Canvas.Top="144" Width="92" Height="92">
                    <Ellipse x:Name="ButtonDPadUp" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Top"
                             Fill="#FFF8FA" Stroke="{StaticResource BorderBrushSoft}" StrokeThickness="1.5" />
                    <Ellipse x:Name="ButtonDPadDown" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                             Fill="#FFF8FA" Stroke="{StaticResource BorderBrushSoft}" StrokeThickness="1.5" />
                    <Ellipse x:Name="ButtonDPadLeft" Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center"
                             Fill="#FFF8FA" Stroke="{StaticResource BorderBrushSoft}" StrokeThickness="1.5" />
                    <Ellipse x:Name="ButtonDPadRight" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"
                             Fill="#FFF8FA" Stroke="{StaticResource BorderBrushSoft}" StrokeThickness="1.5" />
                </Grid>

                <Ellipse x:Name="ButtonLeftStick" Canvas.Left="195" Canvas.Top="188" Width="52" Height="52"
                         Fill="#FFF1F5" Stroke="{StaticResource BorderBrushSoft}" StrokeThickness="2" />
                <Ellipse x:Name="ButtonRightStick" Canvas.Left="273" Canvas.Top="188" Width="52" Height="52"
                         Fill="#FFF1F5" Stroke="{StaticResource BorderBrushSoft}" StrokeThickness="2" />
                <Ellipse Canvas.Left="209" Canvas.Top="202" Width="24" Height="24" Fill="#F8D8E1" Opacity="0.75" />
                <Ellipse Canvas.Left="287" Canvas.Top="202" Width="24" Height="24" Fill="#F8D8E1" Opacity="0.75" />

                <Border x:Name="ButtonBack" Canvas.Left="204" Canvas.Top="148" Width="54" Height="24" CornerRadius="10"
                        Background="#FFF8FA" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1.3">
                    <TextBlock x:Name="LabelBack" Text="Back" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" />
                </Border>
                <Border x:Name="ButtonStart" Canvas.Left="262" Canvas.Top="148" Width="58" Height="24" CornerRadius="10"
                        Background="#FFF8FA" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1.3">
                    <TextBlock x:Name="LabelStart" Text="Start" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" />
                </Border>

                <Ellipse x:Name="ButtonY" Canvas.Left="386" Canvas.Top="133" Width="38" Height="38"
                         Fill="#FFF8FA" Stroke="{StaticResource BorderBrushSoft}" StrokeThickness="1.5" />
                <TextBlock x:Name="LabelY" Canvas.Left="400" Canvas.Top="139" Text="Y" FontWeight="Bold" FontSize="16" />
                <Ellipse x:Name="ButtonX" Canvas.Left="350" Canvas.Top="170" Width="38" Height="38"
                         Fill="#FFF8FA" Stroke="{StaticResource BorderBrushSoft}" StrokeThickness="1.5" />
                <TextBlock x:Name="LabelX" Canvas.Left="364" Canvas.Top="176" Text="X" FontWeight="Bold" FontSize="16" />
                <Ellipse x:Name="ButtonB" Canvas.Left="422" Canvas.Top="170" Width="38" Height="38"
                         Fill="#FFF8FA" Stroke="{StaticResource BorderBrushSoft}" StrokeThickness="1.5" />
                <TextBlock x:Name="LabelB" Canvas.Left="436" Canvas.Top="176" Text="B" FontWeight="Bold" FontSize="16" />
                <Ellipse x:Name="ButtonA" Canvas.Left="386" Canvas.Top="207" Width="38" Height="38"
                         Fill="#FFF8FA" Stroke="{StaticResource BorderBrushSoft}" StrokeThickness="1.5" />
                <TextBlock x:Name="LabelA" Canvas.Left="400" Canvas.Top="213" Text="A" FontWeight="Bold" FontSize="16" />
            </Canvas>
        </Viewbox>
    </Grid>
</UserControl>
