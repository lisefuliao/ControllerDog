<UserControl x:Class="DouDouDeDou.Controls.ControllerPreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="210">
    <Grid>
        <Viewbox Stretch="Uniform">
            <Canvas Width="340" Height="220">
                <Path x:Name="BodyPath"
                      Fill="#FFFDFE"
                      Stroke="{StaticResource BorderBrushSoft}"
                      StrokeThickness="3"
                      Data="M70,70 C40,78 25,108 22,142 C19,176 35,195 58,190 C78,186 88,160 105,154 L235,154 C252,160 262,186 282,190 C305,195 321,176 318,142 C315,108 300,78 270,70 C245,58 220,62 199,74 L141,74 C120,62 95,58 70,70 Z" />

                <Border x:Name="ButtonLT" Canvas.Left="62" Canvas.Top="34" Width="72" Height="24" CornerRadius="8"
                        Background="#F5E1E8" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
                    <TextBlock x:Name="LabelLT" Text="LT" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                </Border>
                <Border x:Name="ButtonRT" Canvas.Left="206" Canvas.Top="34" Width="72" Height="24" CornerRadius="8"
                        Background="#F5E1E8" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
                    <TextBlock x:Name="LabelRT" Text="RT" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                </Border>
                <Border x:Name="ButtonLB" Canvas.Left="70" Canvas.Top="61" Width="64" Height="22" CornerRadius="8"
                        Background="#F9EDF1" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
                    <TextBlock x:Name="LabelLB" Text="LB" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                </Border>
                <Border x:Name="ButtonRB" Canvas.Left="206" Canvas.Top="61" Width="64" Height="22" CornerRadius="8"
                        Background="#F9EDF1" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
                    <TextBlock x:Name="LabelRB" Text="RB" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                </Border>

                <Ellipse x:Name="ButtonDPadUp" Canvas.Left="78" Canvas.Top="99" Width="22" Height="22"
                         Fill="#F9EDF1" Stroke="{StaticResource BorderBrushSoft}" StrokeThickness="1" />
                <Ellipse x:Name="ButtonDPadDown" Canvas.Left="78" Canvas.Top="141" Width="22" Height="22"
                         Fill="#F9EDF1" Stroke="{StaticResource BorderBrushSoft}" StrokeThickness="1" />
                <Ellipse x:Name="ButtonDPadLeft" Canvas.Left="57" Canvas.Top="120" Width="22" Height="22"
                         Fill="#F9EDF1" Stroke="{StaticResource BorderBrushSoft}" StrokeThickness="1" />
                <Ellipse x:Name="ButtonDPadRight" Canvas.Left="99" Canvas.Top="120" Width="22" Height="22"
                         Fill="#F9EDF1" Stroke="{StaticResource BorderBrushSoft}" StrokeThickness="1" />

                <Ellipse x:Name="ButtonLeftStick" Canvas.Left="126" Canvas.Top="126" Width="34" Height="34"
                         Fill="#F6E2E9" Stroke="{StaticResource BorderBrushSoft}" StrokeThickness="2" />
                <Ellipse x:Name="ButtonRightStick" Canvas.Left="180" Canvas.Top="126" Width="34" Height="34"
                         Fill="#F6E2E9" Stroke="{StaticResource BorderBrushSoft}" StrokeThickness="2" />

                <Border x:Name="ButtonBack" Canvas.Left="136" Canvas.Top="92" Width="34" Height="18" CornerRadius="8"
                        Background="#F9EDF1" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
                    <TextBlock x:Name="LabelBack" Text="Back" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontWeight="SemiBold" FontSize="9" Foreground="{StaticResource TextPrimaryBrush}" />
                </Border>
                <Border x:Name="ButtonStart" Canvas.Left="170" Canvas.Top="92" Width="38" Height="18" CornerRadius="8"
                        Background="#F9EDF1" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
                    <TextBlock x:Name="LabelStart" Text="Start" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontWeight="SemiBold" FontSize="9" Foreground="{StaticResource TextPrimaryBrush}" />
                </Border>

                <Ellipse x:Name="ButtonY" Canvas.Left="250" Canvas.Top="92" Width="28" Height="28"
                         Fill="#F9EDF1" Stroke="{StaticResource BorderBrushSoft}" StrokeThickness="1" />
                <TextBlock x:Name="LabelY" Canvas.Left="259" Canvas.Top="96" Text="Y" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                <Ellipse x:Name="ButtonX" Canvas.Left="226" Canvas.Top="118" Width="28" Height="28"
                         Fill="#F9EDF1" Stroke="{StaticResource BorderBrushSoft}" StrokeThickness="1" />
                <TextBlock x:Name="LabelX" Canvas.Left="235" Canvas.Top="122" Text="X" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                <Ellipse x:Name="ButtonB" Canvas.Left="274" Canvas.Top="118" Width="28" Height="28"
                         Fill="#F9EDF1" Stroke="{StaticResource BorderBrushSoft}" StrokeThickness="1" />
                <TextBlock x:Name="LabelB" Canvas.Left="283" Canvas.Top="122" Text="B" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                <Ellipse x:Name="ButtonA" Canvas.Left="250" Canvas.Top="144" Width="28" Height="28"
                         Fill="#F9EDF1" Stroke="{StaticResource BorderBrushSoft}" StrokeThickness="1" />
                <TextBlock x:Name="LabelA" Canvas.Left="259" Canvas.Top="148" Text="A" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            </Canvas>
        </Viewbox>
    </Grid>
</UserControl>
