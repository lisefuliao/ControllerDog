<UserControl x:Class="DouDouDeDou.Controls.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Border Style="{StaticResource EmptyStateStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="38"
                    Height="38"
                    CornerRadius="14"
                    Background="{DynamicResource AccentSoftBrush}"
                    Margin="0,0,12,0"
                    VerticalAlignment="Top">
                <TextBlock Text="{Binding IconGlyph, ElementName=Root}"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="17"
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Title, ElementName=Root}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontWeight="Bold" />
                <TextBlock Text="{Binding Message, ElementName=Root}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,5,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
