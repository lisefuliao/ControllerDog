<Window x:Class="DouDouDeDou.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DouDouDeDou.Controls"
        Title="抖抖的抖"
        Width="1380"
        Height="840"
        MinWidth="1180"
        MinHeight="720"
        FontFamily="Microsoft YaHei UI"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="抖抖的抖"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,18,0" />
                    <Button Content="开始映射"
                            Command="{Binding StartMappingCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,10,0" />
                    <Button Content="停止映射"
                            Command="{Binding StopMappingCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,10,0" />
                    <Button Content="保存配置"
                            Command="{Binding SaveConfigCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,10,0" />
                    <Button Content="加载配置"
                            Command="{Binding LoadConfigCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="轮询率"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <ComboBox Width="250"
                              ItemsSource="{Binding PollingRates}"
                              SelectedItem="{Binding SelectedPollingRate, Mode=TwoWay}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,18,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="286" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="370" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="状态" Style="{StaticResource SectionTitleStyle}" />
                    <StackPanel>
                        <controls:StatusBadge Label="当前设备" Value="{Binding CurrentDevice}" />
                        <controls:StatusBadge Label="手柄类型" Value="{Binding ControllerTypeText}" />
                        <controls:StatusBadge Label="输入模式" Value="{Binding InputModeText}" />
                        <controls:StatusBadge Label="连接状态" Value="{Binding ConnectionStatusText}" />
                        <controls:StatusBadge Label="当前轮询率" Value="{Binding CurrentPollingRateText}" />
                        <controls:StatusBadge Label="实际循环频率" Value="{Binding ActualFrequencyText}" />
                        <controls:StatusBadge Label="平均延迟" Value="{Binding AverageLatencyText}" />
                        <controls:StatusBadge Label="异常计数" Value="{Binding ExceptionCountText}" />
                        <controls:StatusBadge Label="防粘键状态" Value="{Binding AntiStickyStatusText}" />
                        <controls:StatusBadge Label="映射状态" Value="{Binding MappingStatusText}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="18,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="点击手柄按键设置映射" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                        <TextBlock Text="点一下图上的 A / B / X / Y / LT / 方向键等，再在弹出的键盘或鼠标图上选择目标。"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="13"
                                   Margin="0,6,0,0" />
                    </StackPanel>

                    <controls:ControllerPreviewControl ControllerType="{Binding PreviewControllerType}"
                                                       PressedButtons="{Binding PressedButtonNames}"
                                                       ButtonCommand="{Binding SelectSourceButtonCommand}"
                                                       MinHeight="520"
                                                       Margin="8" />
                </DockPanel>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="210" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="实时按键状态" Style="{StaticResource SectionTitleStyle}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PressedButtonNames}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SoftPinkBrush}"
                                                BorderBrush="{StaticResource BorderBrushSoft}"
                                                BorderThickness="1"
                                                CornerRadius="9"
                                                Padding="10,5"
                                                Margin="0,0,8,8">
                                            <TextBlock Text="{Binding}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="运行日志" Style="{StaticResource SectionTitleStyle}" />
                        <ListBox ItemsSource="{Binding Logs}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="作者：马德锦大神"
                   HorizontalAlignment="Right"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="12" />
    </Grid>
</Window>
