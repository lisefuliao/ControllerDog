<Window x:Class="DouDouDeDou.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DouDouDeDou.Controls"
        Title="抖抖的抖"
        Width="1480"
        Height="920"
        MinWidth="1260"
        MinHeight="760"
        FontFamily="Microsoft YaHei UI"
        Background="{StaticResource BackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="14" Background="{StaticResource AccentBrush}" Margin="0,0,14,0">
                        <TextBlock Text="抖"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="22"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="抖抖的抖"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="本地手柄到键盘 / 鼠标一对一映射"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Button Content="开始映射"
                            Command="{Binding StartMappingCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,10,0" />
                    <Button Content="停止映射"
                            Command="{Binding StopMappingCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,10,0" />
                    <Button Content="保存配置"
                            Command="{Binding SaveConfigCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,10,0" />
                    <Button Content="加载配置"
                            Command="{Binding LoadConfigCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="轮询率"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <ComboBox Width="210"
                              ItemsSource="{Binding PollingRates}"
                              SelectedItem="{Binding SelectedPollingRate, Mode=TwoWay}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,18,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="设备状态" Style="{StaticResource SectionTitleStyle}" />
                    <StackPanel>
                        <controls:StatusBadge Label="当前设备" Value="{Binding CurrentDevice}" />
                        <controls:StatusBadge Label="手柄类型" Value="{Binding ControllerTypeText}" />
                        <controls:StatusBadge Label="输入模式" Value="{Binding InputModeText}" />
                        <controls:StatusBadge Label="连接状态" Value="{Binding ConnectionStatusText}" />
                        <controls:StatusBadge Label="VID / PID" Value="{Binding VidPidText}" />
                        <controls:StatusBadge Label="Usage" Value="{Binding UsageText}" />
                        <controls:StatusBadge Label="当前轮询率" Value="{Binding CurrentPollingRateText}" />
                        <controls:StatusBadge Label="实际循环频率" Value="{Binding ActualFrequencyText}" />
                        <controls:StatusBadge Label="平均延迟" Value="{Binding AverageLatencyText}" />
                        <controls:StatusBadge Label="异常计数" Value="{Binding ExceptionCountText}" />
                        <controls:StatusBadge Label="防粘键状态" Value="{Binding AntiStickyStatusText}" />
                        <controls:StatusBadge Label="映射状态" Value="{Binding MappingStatusText}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="18,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="映射管理" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                            <TextBlock Text="手柄输入只会绑定到一个键盘键或一个鼠标键，释放时同步释放。"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="添加映射"
                                Command="{Binding AddMappingCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                MinHeight="36"
                                Padding="16,7" />
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Mappings}"
                              RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="手柄按键" Width="1.35*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.SourceButtonOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  Text="{Binding SourceButton, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True"
                                                  MinHeight="32" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="输出类型"
                                                Binding="{Binding OutputTypeDisplayName}"
                                                IsReadOnly="True"
                                                Width="0.8*" />
                            <DataGridTextColumn Header="映射目标"
                                                Binding="{Binding Target.DisplayName}"
                                                IsReadOnly="True"
                                                Width="1.1*" />
                            <DataGridCheckBoxColumn Header="启用"
                                                    Binding="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="0.55*" />
                            <DataGridTemplateColumn Header="编辑" Width="78">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="编辑"
                                                Command="{Binding DataContext.EditMappingCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource TinyButtonStyle}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="删除" Width="78">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="删除"
                                                Command="{Binding DataContext.DeleteMappingCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DangerButtonStyle}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="330" />
                    <RowDefinition Height="170" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="手柄预览" Style="{StaticResource SectionTitleStyle}" />
                        <controls:DevicePreviewControl ControllerType="{Binding PreviewControllerType}"
                                                       PressedButtons="{Binding PressedButtonNames}" />
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="实时按键" Style="{StaticResource SectionTitleStyle}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PressedButtonNames}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SoftPinkBrush}"
                                                BorderBrush="{StaticResource BorderBrushSoft}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="11,6"
                                                Margin="0,0,8,8">
                                            <TextBlock Text="{Binding}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="运行日志" Style="{StaticResource SectionTitleStyle}" />
                        <ListBox ItemsSource="{Binding Logs}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="作者：马德锦大神"
                   HorizontalAlignment="Right"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="12" />
    </Grid>
</Window>
