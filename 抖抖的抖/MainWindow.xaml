<Window x:Class="DouDouDeDou.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DouDouDeDou.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="抖抖的抖"
        Width="1440"
        Height="850"
        MinWidth="1220"
        MinHeight="740"
        Icon="Assets/Branding/AppIcon.png"
        WindowStyle="None"
        ResizeMode="CanResize"
        FontFamily="Microsoft YaHei UI"
        Background="{DynamicResource BackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34"
                            ResizeBorderThickness="6"
                            CornerRadius="12"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="4" Margin="-22" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0FFFFFFF" Offset="0" />
                    <GradientStop Color="#05000000" Offset="0.58" />
                    <GradientStop Color="#12D95782" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid Grid.Row="0" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="Assets/Branding/AppIcon.png" Width="18" Height="18" Margin="2,0,8,0" />
                <TextBlock Text="抖抖的抖" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Style="{StaticResource ProfileChipStyle}" Padding="8,3" Margin="10,0,0,0">
                    <TextBlock Text="{Binding ControllerProtocolText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Click="OnMinimizeClick" Style="{StaticResource WindowCaptionButtonStyle}" ToolTip="最小化">
                    <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                </Button>
                <Button Click="OnMaximizeRestoreClick" Style="{StaticResource WindowCaptionButtonStyle}" ToolTip="最大化/还原">
                    <TextBlock Text="&#xE922;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                </Button>
                <Button Click="OnCloseClick" Style="{StaticResource WindowCaptionCloseButtonStyle}" ToolTip="关闭">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource GlassPanelStyle}" Padding="14" MinHeight="{StaticResource ToolbarHeight}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="14" Background="{DynamicResource AccentSoftBrush}" ClipToBounds="True" Margin="0,0,14,0">
                        <Image Source="Assets/Branding/AppIcon.png" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,28,0">
                        <TextBlock Text="抖抖的抖" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Controller mapper" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <Button Command="{Binding StartMappingCommand}" Style="{StaticResource ToolbarPrimaryIconTextButtonStyle}" MinWidth="128" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="开始映射" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding StopMappingCommand}" Style="{StaticResource ToolbarIconTextButtonStyle}" MinWidth="120" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="停止映射" />
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource ProfileChipStyle}" MinWidth="174">
                        <StackPanel>
                            <TextBlock Text="当前配置" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                            <TextBlock Text="{Binding CurrentProfileName}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource SegmentedControlStyle}" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="轮询率" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,8,0" />
                            <ComboBox Width="130" ItemsSource="{Binding PollingRates}" SelectedItem="{Binding SelectedPollingRate, Mode=TwoWay}" BorderThickness="0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ListDisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                    <Button Content="{Binding ThemeModeIcon}" Command="{Binding ToggleThemeModeCommand}" Style="{StaticResource IconButtonStyle}" ToolTip="{Binding ThemeModeText}" MinWidth="44" Margin="0,0,8,0" />
                    <Button Command="{Binding OpenLogsCommand}" Style="{StaticResource ToolbarIconTextButtonStyle}" MinWidth="96" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource IconBrush}" Margin="0,0,7,0" />
                            <TextBlock Text="日志" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenSettingsCommand}" Style="{StaticResource IconButtonStyle}" ToolTip="设置" MinWidth="44">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource IconBrush}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource DeviceCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="设备" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                            <Border HorizontalAlignment="Right" Style="{StaticResource ProfileChipStyle}" Padding="9,5">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="0,0,7,0" />
                                    <TextBlock Text="{Binding ConnectionStatusText}" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource EmptyStateStyle}" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="46" Height="46" CornerRadius="15" Background="{DynamicResource CardBrush}" Padding="9">
                                    <Image Source="{Binding ControllerLogoPath}" Stretch="Uniform" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ControllerTypeText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ControllerProtocolText}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <controls:StatusBadge Label="当前设备" Value="{Binding CurrentDevice}" />
                        <controls:StatusBadge Label="输入模式" Value="{Binding InputModeText}" />
                        <controls:StatusBadge Label="当前轮询率" Value="{Binding CurrentPollingRateText}" />
                        <controls:StatusBadge Label="实际循环率" Value="{Binding ActualFrequencyText}" />
                        <controls:StatusBadge Label="平均延迟" Value="{Binding AverageLatencyText}" />
                        <controls:StatusBadge Label="异常计数" Value="{Binding ExceptionCountText}" />
                        <controls:StatusBadge Label="防粘键" Value="{Binding AntiStickyStatusText}" />
                        <controls:StatusBadge Label="映射状态" Value="{Binding MappingStatusText}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DeviceCardStyle}">
                    <StackPanel>
                        <TextBlock Text="配置档案" Style="{StaticResource SectionTitleStyle}" />
                        <Border Style="{StaticResource ProfileCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding CurrentProfileName}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" />
                                    <TextBlock Text="{Binding MappingProgressText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="管理" Command="{Binding OpenSettingsCommand}" Style="{StaticResource TinyButtonStyle}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Column="1" Style="{StaticResource StudioSurfaceStyle}" Margin="16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="控制器预览" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                            <TextBlock Text="点击手柄按键设置映射，实时高亮会跟随输入状态。" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,6,0,0" />
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource SegmentedControlStyle}">
                            <TextBlock Text="{Binding ControllerProtocolText}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="10,5" />
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                        <Border Style="{StaticResource HeroMetricStyle}">
                            <StackPanel>
                                <TextBlock Text="循环率" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                <TextBlock Text="{Binding ActualFrequencyText}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource HeroMetricStyle}">
                            <StackPanel>
                                <TextBlock Text="延迟" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                <TextBlock Text="{Binding AverageLatencyText}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource HeroMetricStyle}">
                            <StackPanel>
                                <TextBlock Text="映射" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                <TextBlock Text="{Binding MappingProgressText}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Grid.Row="1"
                            CornerRadius="26"
                            Background="{DynamicResource InputBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrushSoft}"
                            BorderThickness="1"
                            Padding="10"
                            Margin="0,4,0,0">
                        <controls:ControllerPreviewControl ControllerType="{Binding PreviewControllerType}"
                                                           PressedButtons="{Binding PressedButtonSnapshot}"
                                                           ButtonCommand="{Binding SelectSourceButtonCommand}"
                                                           AppearanceStyle="{Binding SelectedControllerAppearanceKey}"
                                                           IsCalibrationMode="False"
                                                           MinHeight="500"
                                                           Margin="4" />
                    </Border>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="9" Height="9" Fill="{DynamicResource AccentBrush}" Margin="0,0,7,0" />
                            <TextBlock Text="已按下" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,22,0" />
                            <Ellipse Width="9" Height="9" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4" Fill="Transparent" Margin="0,0,7,0" />
                            <TextBlock Text="可交互" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,22,0" />
                            <Ellipse Width="9" Height="9" Fill="{DynamicResource DisabledBrush}" Margin="0,0,7,0" />
                            <TextBlock Text="未连接" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <Button Content="清空全部映射" Command="{Binding ClearAllMappingsCommand}" Style="{StaticResource TinyButtonStyle}" HorizontalAlignment="Right" />
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="300" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource AppSurfaceStyle}" Margin="0,0,0,14">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="实时状态" Style="{StaticResource SectionTitleStyle}" />
                        <Border CornerRadius="18" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" Background="{DynamicResource InputBackgroundBrush}" Padding="12">
                            <ItemsControl ItemsSource="{Binding LiveButtonStates}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="ButtonChip" Style="{StaticResource StatusPillBorderStyle}" Margin="0,0,8,8">
                                            <Grid>
                                                <Ellipse x:Name="StateDot" Width="6" Height="6" Fill="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0.55" />
                                                <TextBlock x:Name="ChipText" Text="{Binding Label}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter TargetName="ButtonChip" Property="Background" Value="{DynamicResource ChipPressedBackgroundBrush}" />
                                                <Setter TargetName="ButtonChip" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                <Setter TargetName="ChipText" Property="Foreground" Value="White" />
                                                <Setter TargetName="StateDot" Property="Fill" Value="White" />
                                                <Setter TargetName="StateDot" Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource AppSurfaceStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="当前映射" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                            <Border HorizontalAlignment="Right" Style="{StaticResource ProfileChipStyle}" Padding="9,5">
                                <TextBlock Text="{Binding MappingProgressText}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="12" />
                            </Border>
                        </Grid>

                        <controls:EmptyState Title="暂无映射"
                                             Message="点击手柄上的按键开始设置。"
                                             IconGlyph="&#xE8A5;"
                                             Visibility="{Binding MappingEmptyVisibility}" />

                        <ItemsControl ItemsSource="{Binding MappingOverviewItems}" Visibility="{Binding MappingOverviewVisibility}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CompactMappingRowBorderStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="86" />
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Source}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="→" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Target}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="配置管理" Command="{Binding OpenSettingsCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" />
                            <Button Content="查看日志" Command="{Binding OpenLogsCommand}" Style="{StaticResource OutlineButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="3">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Ellipse Width="9" Height="9" Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0" />
                <TextBlock Text="一切运行正常" Foreground="{DynamicResource SuccessBrush}" FontSize="12" />
            </StackPanel>
            <TextBlock Text="v0.5 UI Preview · 本地运行 · 无外部依赖"
                       HorizontalAlignment="Right"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="12" />
        </Grid>
    </Grid>
</Window>
